node_modules
dist
out
# Ignore electron-builder's buildResources dir contents, but keep the app icon
# (the only tracked asset there — used to generate the installer + exe icons).
/build/*
!/build/icon.png
*.log
.DS_Store

# TypeScript incremental build cache (generated)
*.tsbuildinfo

# electron-vite writes a timestamped copy of the config next to it while loading,
# and deletes it again straight after. An interrupted run leaves one behind — this
# keeps that leftover out of a commit.
electron.vite.config.*.mjs

# Local Claude Code config / hooks — project-specific, not for end users
.claude

# Dev-only material — NOT part of the repo. Shipped code must never reference it
# (see memory: breadcraft-repo-structure). The SSOT lives in src/shared/, not here.
_intern

# Dev-only briefing for an image model (cheat-sheet artwork); not part of the repo
BREADCRAFT_CHEATSHEET_BRIEFING.md
